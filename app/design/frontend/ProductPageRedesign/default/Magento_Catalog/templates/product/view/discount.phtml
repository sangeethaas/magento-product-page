<?php
/** @var \Magento\Catalog\Block\Product\View $block */
/** @var \Magento\Framework\Escaper $escaper */
$product = $block->getProduct();
$priceInfo = $product->getPriceInfo();
$regular = (float) $priceInfo->getPrice('regular_price')->getAmount()->getValue();
$final = (float) $priceInfo->getPrice('final_price')->getAmount()->getValue();
$percent = ($regular > 0 && $final < $regular) ? (int) round((1 - $final / $regular) * 100) : 0;
?>
<?php if ($percent > 0): ?>
    <div class="product-discount">
        <span class="product-discount__text"><?= $escaper->escapeHtml(__('(-%1% OFF)', $percent)) ?></span>
    </div>
<?php endif; ?>
